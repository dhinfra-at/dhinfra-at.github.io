---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';

const metadata = {
  title: 'Open Source Software',
};

const prose =
  'mx-auto max-w-4xl px-4 py-12 sm:px-6 [&_h2]:scroll-mt-24 [&_h2]:text-2xl [&_h2]:font-bold [&_h3]:mt-6 [&_h3]:text-lg [&_h3]:font-semibold [&_p]:mt-3 [&_section]:border-t [&_section]:border-gray-100 [&_section]:py-10 dark:[&_section]:border-slate-800 [&_a]:text-primary [&_a]:hover:underline [&_ul]:mt-3 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-1 [&_table]:my-4 [&_table]:w-full [&_table]:max-w-xl [&_table]:text-sm [&_th]:border-b [&_th]:border-gray-200 [&_th]:py-2 [&_th]:pr-4 [&_th]:text-left [&_td]:border-b [&_td]:border-gray-100 [&_td]:py-2 [&_td]:pr-4 dark:[&_th]:border-slate-700 dark:[&_td]:border-slate-800';
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Open Source Software"
    title="Free and open-source DH tools"
    subtitle="Three Digital Humanities tools we invested in — clearer documentation, easier setup, and active development. Depending on your use case, they run on our cluster and elsewhere."
  />

  <div class={prose}>
    <!-- Intro: the software journey -->
    <section class="!border-t-0 !pt-0">
      <p>
        The work followed a path of needs assessment, evaluation, expert workshops, and development. Per-tool working
        papers and an overarching evaluation paper are due from Q2 2026. Below: what each tool is, what we changed, and
        where to find it.
      </p>
    </section>

    <!-- QLever -->
    <section id="qlever">
      <h2>QLever</h2>
      <p>
        An efficient SPARQL engine for querying very large knowledge graphs (such as Wikidata) — over 100 billion
        triples on a single standard machine, with markedly faster responses than most alternatives.
      </p>

      <h3>What we improved</h3>
      <table>
        <thead><tr><th>Before</th><th>After (DHinfra)</th></tr></thead>
        <tbody>
          <tr><td>Steep entry barrier for new users</td><td>Quickstart &amp; step-by-step guides</td></tr>
          <tr><td>Docs scattered, patchy, partly outdated</td><td>Fresh, unified docs (continually expanded)</td></tr>
          <tr><td>No standardized, reusable examples</td><td>Ready-to-use, versioned Qleverfiles</td></tr>
        </tbody>
      </table>

      <ul>
        <li>
          <strong>Documentation</strong> — completely rebuilt at
          <a href="https://docs.qlever.dev/" target="_blank" rel="noopener noreferrer">docs.qlever.dev</a> (since late 2025,
          continually expanded): quickstart, Qleverfile reference, troubleshooting.
        </li>
        <li>
          <strong>Use cases</strong> — unified Qleverfiles (24 commits since Dec 2025), publicly provided via pull request
          (<code>qlever setup-config</code>); overview with dataset size, resources and live demos at
          <a href="https://docs.qlever.dev/use-cases/" target="_blank" rel="noopener noreferrer"
            >docs.qlever.dev/use-cases</a
          >.
        </li>
        <li>
          <strong>Deployment</strong> — official packages for Debian / Ubuntu / macOS (since 21 Jan 2026); Docker images (QLever
          UI &amp; Petrimaps); reproducible and tested before every release.
        </li>
        <li>
          <strong>DHinfra.at fork</strong> —
          <a href="https://github.com/dhinfra-at/qlever" target="_blank" rel="noopener noreferrer"
            >github.com/dhinfra-at/qlever</a
          >.
        </li>
      </ul>
    </section>

    <!-- liiive.now -->
    <section id="liiive">
      <h2>liiive.now</h2>
      <p>
        Real-time collaborative image annotation built on IIIF — annotate together, live, in the browser.
        <a href="https://github.com/rsimon/liiive" target="_blank" rel="noopener noreferrer">github.com/rsimon/liiive</a
        >
        (MIT licence); DHinfra.at fork at
        <a href="https://github.com/dhinfra-at/liiive" target="_blank" rel="noopener noreferrer"
          >github.com/dhinfra-at/liiive</a
        >.
      </p>

      <h3>Two ways to run it</h3>
      <ul>
        <li><strong>Hosted</strong> — no installation, instantly usable; ideal for teaching and demos.</li>
        <li>
          <strong>Self-hosted</strong> — your own server / VPS (institution or cloud) for full control over your data.
        </li>
      </ul>

      <h3>What it does</h3>
      <ul>
        <li>Real-time collaboration with shared navigation and live cursor tracking</li>
        <li>Comments and threads on annotations</li>
        <li>IIIF API support and annotation export</li>
        <li>Anonymous sessions via a shared link — no login required</li>
      </ul>

      <h3>Under the hood</h3>
      <p>
        Browser-based web app · real-time sync over WebSockets · Supabase database · IIIF Image &amp; Presentation API ·
        self-hostable. Typical uses: manuscript analysis and source annotation in DH, seminars and group work in
        teaching, and curatorial collaboration in cultural institutions.
      </p>
    </section>

    <!-- Pletka (formerly Zellij) -->
    <section id="pletka">
      <span id="zellij"></span>
      <h2>Pletka (formerly Zellij)</h2>
      <p>
        <a href="https://pletkaproject.org" target="_blank" rel="noopener noreferrer">The Pletka Project</a>
        (pletkaproject.org) develops an open-source platform for building and documenting semantic data models together. Projects
        describe their data as fields, collections and models, grounded in ontologies such as CIDOC CRM and Linked Art. From
        this single documentation, Pletka generates the parts an implementation needs: RDF and JSON-LD, SPARQL queries, X3ML
        mapping files, and files for systems such as ResearchSpace.
      </p>
      <p>
        The core code is open source under the Apache 2.0 licence. Pletka is designed by Takin.solutions, engineered by
        Delving BV, and developed together with the Swiss Art Research Infrastructure (SARI, ARDEAH project) and
        DHinfra.at.
      </p>

      <h3>What we improved</h3>
      <table>
        <thead><tr><th>Before (Zellij)</th><th>After (Pletka)</th></tr></thead>
        <tbody>
          <tr>
            <td>Data held in Airtable, several bases per project</td><td
              >Pluggable storage on PostgreSQL, with project versioning</td
            >
          </tr>
          <tr>
            <td>Projects set up by hand</td><td
              >Web admin dashboard for organizations, users, projects and pattern libraries</td
            >
          </tr>
          <tr>
            <td>Generators behind a button</td><td
              >Derivatives: RDF, JSON-LD, SPARQL, X3ML and more, generated from the model</td
            >
          </tr>
        </tbody>
      </table>

      <h3>Who it is for</h3>
      <p>
        Projects that model their data with CIDOC CRM or Linked Art, or build on WissKI, Arches or ResearchSpace.
        <a href="https://pletka.io/projects" target="_blank" rel="noopener noreferrer">pletka.io</a> holds more than 40 public
        models that were built with Zellij and moved over, among them
        <a href="https://pletka.io/projects/RLV" target="_blank" rel="noopener noreferrer">Releven</a> at the Austrian Academy
        of Sciences, the SARI reference data models and Linked Art. A new project can adopt and adapt these patterns instead
        of starting from the ontology specification.
      </p>

      <ul>
        <li>
          <strong>Code</strong> —
          <a href="https://github.com/pletka-io/pletka" target="_blank" rel="noopener noreferrer"
            >github.com/pletka-io/pletka</a
          > (Apache 2.0)
        </li>
        <li>
          <strong>Project and community</strong> —
          <a href="https://pletkaproject.org" target="_blank" rel="noopener noreferrer">pletkaproject.org</a>
        </li>
        <li>
          <strong>Hosted service</strong> —
          <a href="https://pletka.io" target="_blank" rel="noopener noreferrer">pletka.io</a>
        </li>
      </ul>
    </section>
  </div>

  <!-- Back to overview -->
  <div class="mx-auto max-w-4xl px-4 pb-12 sm:px-6">
    <a class="text-primary hover:underline" href="/resources">&larr; Back to all resources</a>
  </div>
</Layout>

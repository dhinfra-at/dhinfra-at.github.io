---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import ResourceCards from '~/components/ResourceCards.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'DHinfra.at — Digital Humanities Infrastructure in Austria',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero ************************** -->

  <Hero
    actions={[
      { variant: 'primary', text: 'Explore resources', href: '/resources' },
      { text: 'Open for collaboration', href: '/contact' },
    ]}
  >
    <Fragment slot="title">
      Shared infrastructure for<br class="hidden sm:inline" /> Digital Humanities in Austria
    </Fragment>

    <Fragment slot="subtitle">
      We pool <span class="whitespace-nowrap">compute</span>,
      <span class="whitespace-nowrap">development services</span>,
      <span class="whitespace-nowrap">digitization</span>, and
      <span class="whitespace-nowrap">open-source software</span> across Austrian institutions &mdash; so DH projects
      that lack resources or skills can still get the job done. A
      <span class="font-semibold">CLARIAH-AT</span> initiative.
    </Fragment>
  </Hero>

  <!-- Positioning note ************* -->

  <Note
    title="What we do:"
    description="More compute, easier access, and better support for digital humanities — democratizing infrastructure for all."
  />

  <!-- Event spotlight ************** -->

  <section id="public-launch" class="mx-auto max-w-4xl px-4 pt-12 sm:px-6 md:pt-16 not-prose">
    <div class="rounded-lg border border-primary/30 bg-blue-50 p-6 dark:bg-slate-800 md:p-8">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary">Public launch event &middot; online</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight dark:text-white sm:text-3xl">
        GPU cluster and large language models for the humanities
      </h2>
      <p class="mt-3 text-lg font-semibold">Monday, 12 October 2026, 10:00 to 11:30 CEST, on Zoom</p>
      <p class="mt-3 text-muted">
        We present DHinfra.at, with a focus on the GPU cluster and its language models: what they can do, how to get in,
        and what already runs on them. From 1 October we accept project applications from research and teaching in the
        humanities in Austria; accepted projects use the cluster free of charge until 31 December 2026.
      </p>
      <p class="mt-3 text-muted">The presentation is in German. Questions in English are welcome.</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a
          class="btn-primary"
          href="https://uni-graz.zoom.us/j/63796915567"
          target="_blank"
          rel="noopener">Join on Zoom</a
        >
        <a class="btn" href="/gpu-cluster">About the GPU cluster</a>
      </div>
      <p class="mt-4 text-sm text-muted">
        Meeting ID 637 9691 5567. Please join with your full name so we can let you in from the waiting
        room. The University of Graz
        <a
          class="underline"
          href="https://static.uni-graz.at/fileadmin/_files/_uniit/datenschutz/zoom/zoom_Datenschutzerklaerung_Gaeste.pdf"
          target="_blank"
          rel="noopener">privacy notice for Zoom guests</a
        > applies.
      </p>
    </div>
  </section>

  <!-- Resource compartments ******* -->

  <section id="resources" class="mx-auto max-w-5xl px-4 py-12 sm:px-6 md:py-16">
    <div class="mb-8 text-center">
      <p class="text-base font-semibold uppercase tracking-wide text-primary">Resources</p>
      <h2 class="text-3xl font-bold tracking-tight dark:text-white sm:text-4xl">What DHinfra.at offers</h2>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-muted">
        Distinct infrastructure parts, contributed by partners across Austria. Open each one for details and contacts.
      </p>
    </div>
    <ResourceCards />
  </section>

  <!-- Project stats *************** -->

  <Stats
    title="The DHinfra.at consortium"
    stats={[
      { title: 'Institutions', amount: '9' },
      { title: 'Working groups', amount: '4' },
      { title: 'Members', amount: '50+' },
      { title: 'Associates', amount: '100+' },
    ]}
  />

  <!-- Latest use cases *********** -->

  <BlogLatestPosts
    title="Use cases & news"
    information={`Real projects on our infrastructure, announcements, and reports from across the consortium.`}
  />

  <!-- Collaboration CTA ********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get in touch',
        href: '/contact',
        icon: 'tabler:mail',
      },
    ]}
  >
    <Fragment slot="title">Lacking resources or skills for your DH project?</Fragment>

    <Fragment slot="subtitle">
      We are open to project collaborations and happy to help in joint projects. Contact us and we will try to find the
      best solution for your idea.
    </Fragment>
  </CallToAction>
</Layout>
